foreach(REQUIRED_VAR TOOL_NAME TOOL_URL TOOL_SHA256 TOOL_ARCHIVE_MEMBER TOOL_OUTPUT)
    if(NOT DEFINED ${REQUIRED_VAR} OR "${${REQUIRED_VAR}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${REQUIRED_VAR} while fetching a 3DS host tool")
    endif()
endforeach()

if(EXISTS "${TOOL_OUTPUT}")
    return()
endif()

get_filename_component(TOOL_OUTPUT_DIR "${TOOL_OUTPUT}" DIRECTORY)
set(TOOL_ARCHIVE "${TOOL_OUTPUT}.zip")
set(TOOL_EXTRACT_DIR "${TOOL_OUTPUT}.extract")
file(MAKE_DIRECTORY "${TOOL_OUTPUT_DIR}")
file(REMOVE_RECURSE "${TOOL_EXTRACT_DIR}")
file(DOWNLOAD "${TOOL_URL}" "${TOOL_ARCHIVE}"
    EXPECTED_HASH "SHA256=${TOOL_SHA256}"
    TLS_VERIFY ON
    SHOW_PROGRESS
)
file(MAKE_DIRECTORY "${TOOL_EXTRACT_DIR}")
file(ARCHIVE_EXTRACT INPUT "${TOOL_ARCHIVE}" DESTINATION "${TOOL_EXTRACT_DIR}")

set(TOOL_EXTRACTED "${TOOL_EXTRACT_DIR}/${TOOL_ARCHIVE_MEMBER}")
if(NOT EXISTS "${TOOL_EXTRACTED}")
    message(FATAL_ERROR "${TOOL_NAME} archive did not contain ${TOOL_ARCHIVE_MEMBER}")
endif()

file(COPY_FILE "${TOOL_EXTRACTED}" "${TOOL_OUTPUT}" ONLY_IF_DIFFERENT)
if(NOT CMAKE_HOST_WIN32)
    file(CHMOD "${TOOL_OUTPUT}" PERMISSIONS
        OWNER_READ OWNER_WRITE OWNER_EXECUTE
        GROUP_READ GROUP_EXECUTE
        WORLD_READ WORLD_EXECUTE
    )
endif()
file(REMOVE "${TOOL_ARCHIVE}")
file(REMOVE_RECURSE "${TOOL_EXTRACT_DIR}")
message(STATUS "Installed ${TOOL_NAME} at ${TOOL_OUTPUT}")
