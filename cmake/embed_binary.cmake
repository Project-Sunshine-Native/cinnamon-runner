if(NOT DEFINED INPUT OR INPUT STREQUAL "")
    message(FATAL_ERROR "INPUT is required")
endif()
if(NOT DEFINED OUTPUT OR OUTPUT STREQUAL "")
    message(FATAL_ERROR "OUTPUT is required")
endif()
if(NOT DEFINED SYMBOL OR NOT SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "SYMBOL must be a valid C identifier")
endif()
if(NOT EXISTS "${INPUT}")
    message(FATAL_ERROR "Input file does not exist: ${INPUT}")
endif()

get_filename_component(OUTPUT_DIRECTORY "${OUTPUT}" DIRECTORY)
if(NOT OUTPUT_DIRECTORY STREQUAL "")
    file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
endif()

file(READ "${INPUT}" BINARY_HEX HEX)
string(LENGTH "${BINARY_HEX}" BINARY_HEX_LENGTH)

set(C_SOURCE "#include <stddef.h>\n#include <stdint.h>\n\n")
string(APPEND C_SOURCE "const uint8_t ${SYMBOL}[] __attribute__((aligned(4))) = {\n")
set(OFFSET 0)
while(OFFSET LESS BINARY_HEX_LENGTH)
    math(EXPR REMAINING "${BINARY_HEX_LENGTH} - ${OFFSET}")
    if(REMAINING GREATER 32)
        set(LINE_LENGTH 32)
    else()
        set(LINE_LENGTH ${REMAINING})
    endif()

    string(SUBSTRING "${BINARY_HEX}" ${OFFSET} ${LINE_LENGTH} HEX_LINE)
    string(REGEX REPLACE "(..)" "0x\\1, " HEX_LINE "${HEX_LINE}")
    string(REGEX REPLACE ", $" "," HEX_LINE "${HEX_LINE}")
    string(APPEND C_SOURCE "    ${HEX_LINE}\n")
    math(EXPR OFFSET "${OFFSET} + ${LINE_LENGTH}")
endwhile()
string(APPEND C_SOURCE "};\n\nconst size_t ${SYMBOL}_size = sizeof(${SYMBOL});\n")

file(WRITE "${OUTPUT}" "${C_SOURCE}")
